---
import Base from '../layouts/Base.astro'
import { project, releases } from '../data/betterthenever.ts'
const year = (d: string) => d.slice(0, 4)
const ep = releases[0]
const single = releases[1]
---
<Base title="Better The Never" description={`${project.name}: ${project.summary}`} image="/better-the-never/than-ever-1200.jpg">
  <section class="rounded-box overflow-hidden mt-2 rise text-white" style="background: radial-gradient(120% 90% at 85% 10%, #3a2a3a 0%, #121016 55%, #0b0a0d 100%);">
    <div class="grid md:grid-cols-[1fr_1.1fr] items-center">
      <div class="p-8 sm:p-12 space-y-6">
        <h1 class="text-[11px] sm:text-sm font-sans font-medium tracking-[0.55em] uppercase text-white/85">Better<br />The Never</h1>
        <p class="text-4xl sm:text-5xl font-semibold text-[#f2a65a] tracking-wide">{ep.title}</p>
        <p class="text-white/75 max-w-md leading-relaxed">{project.summary}</p>
        <div class="flex flex-wrap gap-2">
          {project.links.map((l) => (
            <a href={l.url} target="_blank" rel="noopener" class="btn btn-sm btn-outline text-white border-white/40 hover:bg-white hover:text-black">{l.label}</a>
          ))}
        </div>
      </div>
      <div class="p-8 sm:p-12 md:pl-0">
        <img src={project.art.src} srcset={`${project.art.small} 600w, ${project.art.src} 1200w`} sizes="(min-width: 768px) 45vw, 100vw" width="1200" height="1200" alt={project.art.alt} class="w-full max-w-md mx-auto rounded-box shadow-2xl rotate-[-1.5deg]" />
      </div>
    </div>
  </section>

  <section class="pt-14">
    <div class="rounded-box overflow-hidden bg-black shadow-xl">
      <video controls preload="none" playsinline poster={project.video.poster} width={project.video.width} height={project.video.height} class="w-full aspect-[720/378] bg-black">
        <source src={project.video.src} type="video/mp4" />
      </video>
    </div>
    <p class="mt-3 text-sm text-base-content/60">{project.video.title}, from <em>{ep.title}</em></p>
  </section>

  <section class="pt-14">
    <h2 class="text-3xl font-semibold mb-6">Releases</h2>
    <div class="grid gap-6 md:grid-cols-[1.4fr_1fr]">
      <article class="card bg-base-100 shadow-sm">
        <div class="card-body sm:flex-row gap-6">
          <img src={project.art.small} width="600" height="600" alt="" class="w-32 h-32 rounded-field object-cover shrink-0" loading="lazy" />
          <div class="flex-1 space-y-3">
            <p class="text-sm text-base-content/60">{ep.kind} · {year(ep.date)}</p>
            <h3 class="text-2xl font-semibold">{ep.title}</h3>
            <ol class="list-decimal list-inside text-base-content/80 space-y-0.5">
              {ep.tracks!.map((t) => <li>{t}</li>)}
            </ol>
            <div class="flex gap-2 flex-wrap pt-1">
              {ep.links.map((l, i) => <a href={l.url} target="_blank" rel="noopener" class:list={['btn btn-sm', i === 0 ? 'btn-primary' : 'btn-outline']}>{l.label}</a>)}
            </div>
          </div>
        </div>
      </article>
      <article class="card bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <img src={project.art.small} width="600" height="600" alt="" class="w-32 h-32 rounded-field object-cover" loading="lazy" />
          <p class="text-sm text-base-content/60">{single.kind} · {year(single.date)}</p>
          <h3 class="text-2xl font-semibold">{single.title}</h3>
          <div class="flex gap-2 flex-wrap pt-1">
            {single.links.map((l, i) => <a href={l.url} target="_blank" rel="noopener" class:list={['btn btn-sm', i === 0 ? 'btn-primary' : 'btn-outline']}>{l.label}</a>)}
          </div>
        </div>
      </article>
    </div>
  </section>
</Base>
