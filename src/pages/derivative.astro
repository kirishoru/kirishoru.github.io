---
import Base from '../layouts/Base.astro'
import { band, members, releases, photos, photoCredit, shows } from '../data/derivative.ts'
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
---
<Base title="Derivative" description={`${band.name}, ${band.tagline} ${band.bio}`} image="/derivative/the-villains-1200.jpg">
  <div class="derivative">
    <section class="rounded-box bg-black text-white overflow-hidden mt-2 rise">
      <div class="grid md:grid-cols-[1.1fr_1fr]">
        <div class="p-8 sm:p-12 flex flex-col justify-center gap-6">
          <h1 class="sr-only">Derivative</h1>
          <img src="/derivative/wordmark.png" alt="" width="1400" height="600" class="w-full max-w-md -ml-2" />
          <p class="text-2xl sm:text-3xl font-display italic text-[#a880f8]">{band.tagline}</p>
          <p class="text-white/80 max-w-md">{band.bio}</p>
          <p class="text-sm text-white/60">Caleb’s band · {band.location}</p>
          <div class="flex flex-wrap gap-2">
            {band.links.map((l, i) => (
              <a href={l.url} target="_blank" rel="noopener" class:list={['btn btn-sm', i === 0 ? 'bg-[#d84848] border-[#d84848] text-white hover:bg-[#c03a3a]' : 'btn-outline text-white border-white/40 hover:bg-white hover:text-black']}>{l.label}</a>
            ))}
          </div>
        </div>
        <img src={photos[0].src} srcset={`${photos[0].small} 800w, ${photos[0].src} 1600w`} sizes="(min-width: 768px) 45vw, 100vw" alt={photos[0].alt} width="1600" height="1067" class="w-full h-full object-cover min-h-64" />
      </div>
    </section>

    <section class="pt-14 grid gap-8 md:grid-cols-[1fr_1.2fr]">
      <div>
        <h2 class="text-3xl font-semibold mb-4">The band</h2>
        <ul class="divide-y divide-base-300 border-y border-base-300">
          {members.map((m) => (
            <li class="flex justify-between gap-4 py-3"><span class="font-medium">{m.name}</span><span class="text-base-content/60">{m.role}</span></li>
          ))}
        </ul>
        <div role="status" class="alert alert-soft mt-6 border-l-4 border-l-[#a880f8]">
          <span>{band.status}</span>
        </div>
      </div>
      <div>
        <h2 class="text-3xl font-semibold mb-4">Releases</h2>
        <div class="space-y-4">
          {releases.map((r) => (
            <a href={r.url} target="_blank" rel="noopener" class="card card-side bg-base-100 shadow-sm hover:shadow-lg transition overflow-hidden">
              {r.cover
                ? <img src={r.cover} alt={`${r.title} cover`} width="600" height="600" class="w-28 sm:w-36 object-cover" loading="lazy" />
                : <div class="w-28 sm:w-36 bg-black grid place-items-center"><img src="/derivative/logo-d.png" alt="" width="512" height="512" class="w-16" loading="lazy" /></div>}
              <div class="card-body py-4 gap-1">
                <p class="text-sm text-base-content/60">{r.kind} · {r.year}</p>
                <h3 class="text-xl font-semibold">{r.title}</h3>
                {r.tracks && <p class="text-sm text-base-content/70">{r.tracks.join(' / ')}</p>}
                <p class="text-sm mt-1">Listen on Bandcamp →</p>
              </div>
            </a>
          ))}
        </div>
        <iframe title="Derivative on Spotify" src={band.spotifyEmbed} width="100%" height="152" loading="lazy" allow="encrypted-media; clipboard-write; fullscreen; picture-in-picture" class="rounded-box border-0 mt-4"></iframe>
      </div>
    </section>

    <section class="pt-16">
      <div class="flex items-end justify-between gap-4 flex-wrap mb-6">
        <h2 class="text-3xl font-semibold">Photos</h2>
        <p class="text-sm text-base-content/60">Photos by <a class="link" href={photoCredit.url} target="_blank" rel="noopener">{photoCredit.name}</a></p>
      </div>
      <div class="columns-2 md:columns-3 gap-3 [&>a]:mb-3">
        {photos.slice(1).map((p) => (
          <a href={p.src} target="_blank" class="block break-inside-avoid rounded-field overflow-hidden">
            <img src={p.small} alt={p.alt} width={p.orient === 'h' ? 800 : 533} height={p.orient === 'h' ? 533 : 800} loading="lazy" class="w-full hover:scale-[1.02] transition duration-300" />
          </a>
        ))}
      </div>
    </section>

    <section class="pt-16">
      <h2 class="text-3xl font-semibold mb-6">Past shows</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {shows.map((s) => (
          <article class="card bg-base-100 shadow-sm overflow-hidden">
            <img src={s.flyer} alt={`Flyer for ${s.venue}, ${fmt(s.date)}`} loading="lazy" class="w-full aspect-[4/5] object-cover object-top" />
            <div class="card-body gap-1 py-4">
              <p class="text-sm text-base-content/60">{fmt(s.date)}</p>
              <h3 class="text-lg font-semibold">{s.venue}</h3>
              <p class="text-sm text-base-content/70">{s.address}</p>
              <p class="text-sm mt-1">with {s.with.join(', ')}{s.presenter && <span class="text-base-content/60"> · presented by {s.presenter}</span>}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="pt-16">
      <div class="rounded-box bg-black text-white p-8 sm:p-12 grid gap-6 md:grid-cols-[1fr_auto] items-center">
        <div>
          <h2 class="text-3xl font-semibold">Contact</h2>
          <p class="mt-3 text-lg text-white/85 max-w-xl">{band.contactPitch}</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <a href={`mailto:${band.email}`} class="btn bg-[#d84848] border-[#d84848] text-white hover:bg-[#c03a3a]">EMAIL!</a>
          <a href={band.instagram} target="_blank" rel="noopener" class="btn bg-[#a880f8] border-[#a880f8] text-black hover:bg-[#9670e8]">DM!!</a>
        </div>
      </div>
    </section>
  </div>
</Base>
