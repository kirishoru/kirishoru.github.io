---
import Base from '../layouts/Base.astro'
import QuoteCard from '../components/QuoteCard.astro'
import { artist, photos, release, quotes } from '../data/music.ts'
import { band, releases as dReleases } from '../data/derivative.ts'
const homeQuotes = quotes.filter((q) => q.on.includes('home'))
const short = homeQuotes.filter((q) => !q.lead)
const feature = homeQuotes.find((q) => q.lead)
---
<Base title={artist.name}>
  <section class="grid gap-10 md:grid-cols-[1.2fr_1fr] items-center pt-6 sm:pt-12 pb-16">
    <div class="rise">
      <p class="text-sm uppercase tracking-[0.18em] text-base-content/60">{artist.genre} · {artist.location}</p>
      <h1 class="mt-3 text-5xl sm:text-6xl lg:text-7xl font-semibold leading-[1.02]">{artist.name}</h1>
      <p class="mt-6 text-xl sm:text-2xl font-display leading-snug">{artist.pitch}</p>
      <p class="mt-3 text-base-content/70 max-w-xl">{artist.pitchMore}</p>
      <div class="mt-8 flex gap-3 flex-wrap">
        <a href="#listen" class="btn btn-primary">Listen to {release.title}</a>
        <a href="/press/" class="btn btn-ghost">Press kit</a>
      </div>
    </div>
    <img src={photos.live.src} srcset={`${photos.live.small} 395w, ${photos.live.src} 790w`} sizes="(min-width: 768px) 40vw, 100vw" width={photos.live.width} height={photos.live.height} alt={photos.live.alt} class="w-full max-w-sm md:max-w-none mx-auto rounded-box shadow-xl" />
  </section>

  <section id="listen" class="scroll-mt-8 card bg-base-100 shadow-sm overflow-hidden">
    <div class="grid md:grid-cols-2">
      <img src={release.cover.medium} srcset={`${release.cover.small} 400w, ${release.cover.medium} 700w, ${release.cover.src} 1400w`} sizes="(min-width: 768px) 50vw, 100vw" width="1400" height="1400" alt={release.cover.alt} class="w-full h-full object-cover aspect-square" loading="lazy" />
      <div class="card-body justify-center gap-5 p-6 sm:p-10">
        <p class="text-sm uppercase tracking-[0.18em] text-base-content/60">Album</p>
        <h2 class="text-4xl sm:text-5xl font-semibold">{release.title}</h2>
        <p class="text-base-content/70">{release.status}.</p>
        <div class="flex flex-wrap gap-2">
          {release.links.map((l, i) => (
            <a href={l.url} target="_blank" rel="noopener" class:list={['btn btn-sm', i === 0 ? 'btn-primary' : 'btn-outline']}>{l.label}</a>
          ))}
        </div>
        <iframe title={`${release.title} on Spotify`} src={release.spotifyEmbed} width="100%" height="152" loading="lazy" allow="encrypted-media; clipboard-write; fullscreen; picture-in-picture" class="rounded-box border-0 mt-2"></iframe>
      </div>
    </div>
  </section>

  <section class="pt-16">
    <h2 class="text-3xl font-semibold mb-6">What people are saying</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {feature && <QuoteCard quote={feature} large />}
      {short.map((q) => <QuoteCard quote={q} />)}
    </div>
    <p class="mt-6"><a href="/press/" class="link link-hover text-sm">More in the press kit →</a></p>
  </section>

  <section class="pt-16">
    <h2 class="text-3xl font-semibold mb-6">Projects</h2>
    <a href="/about/" class="card bg-base-100 shadow-sm hover:shadow-lg transition">
      <div class="card-body sm:flex-row sm:items-center gap-6">
        <img src={release.cover.small} width="400" height="400" alt="" class="w-24 h-24 rounded-field object-cover" loading="lazy" />
        <div class="flex-1">
          <h3 class="text-2xl font-semibold">{artist.name}</h3>
          <p class="text-base-content/70 mt-1">Solo work, written, produced, mixed, mastered, and published by Caleb. Latest release: <em>{release.title}</em>.</p>
        </div>
        <span class="btn btn-ghost btn-sm self-start sm:self-center">About →</span>
      </div>
    </a>
    <a href="/derivative/" class="card bg-base-100 shadow-sm hover:shadow-lg transition mt-4">
      <div class="card-body sm:flex-row sm:items-center gap-6">
        <img src="/derivative/the-villains-600.webp" width="600" height="600" alt="" class="w-24 h-24 rounded-field object-cover" loading="lazy" />
        <div class="flex-1">
          <h3 class="text-2xl font-semibold">{band.name}</h3>
          <p class="text-base-content/70 mt-1">Caleb’s band. {band.bio} Latest release: <em>{dReleases[0].title}</em>.</p>
        </div>
        <span class="btn btn-ghost btn-sm self-start sm:self-center">Derivative →</span>
      </div>
    </a>
  </section>
</Base>
