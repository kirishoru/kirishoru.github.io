---
import Base from '../layouts/Base.astro'
import { artist, bio, quotes, craft, release } from '../data/music.ts'
const themes = ['Atmosphere & Vocals', 'Groove & Energy'] as const
const pressQuotes = quotes.filter((q) => q.on.includes('press'))
---
<Base title="Press" description={`Press kit for ${artist.name}: biography, reviews, gear, and contact.`}>
  <section class="pt-8 pb-10 border-b border-base-300">
    <p class="text-sm uppercase tracking-[0.18em] text-base-content/60">Press kit</p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-semibold">{artist.name}</h1>
    <p class="mt-2 text-base-content/70">{artist.genre} | {artist.location}</p>
    <p class="mt-6 font-display text-2xl leading-snug max-w-3xl">“{artist.pitch}”</p>
    <div class="mt-6 flex gap-3 flex-wrap">
      <a href="/press-kit.pdf" class="btn btn-primary" download>Download PDF press kit</a>
      <a href={`mailto:${artist.email}`} class="btn btn-ghost">{artist.email}</a>
    </div>
  </section>

  <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr] pt-10">
    <div class="space-y-12">
      <section>
        <h2 class="text-2xl font-semibold mb-4">Biography</h2>
        <div class="space-y-4 leading-relaxed">{bio.press.map((p) => <p>{p}</p>)}</div>
      </section>
      <section>
        <h2 class="text-2xl font-semibold mb-4">Press &amp; Reviews</h2>
        {themes.map((t) => (
          <div class="mb-8">
            <h3 class="text-sm uppercase tracking-[0.18em] text-base-content/60 font-sans mb-3">{t}</h3>
            <ul class="space-y-4">
              {pressQuotes.filter((q) => q.theme === t).map((q) => (
                <li class="border-l-2 border-primary pl-4">
                  <p class="font-display text-lg leading-snug">“{q.text}”</p>
                  <p class="text-sm text-base-content/60 mt-1">{q.source}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    </div>
    <aside class="space-y-6">
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-5">
          <h2 class="card-title text-2xl">The Craft</h2>
          {Object.entries(craft).map(([k, items]) => (
            <div>
              <h3 class="text-sm uppercase tracking-[0.18em] text-base-content/60 font-sans mb-1">{k}</h3>
              <ul>{items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <h2 class="card-title text-2xl">Connections</h2>
          <p><span class="text-base-content/60 text-sm block">Email</span><a class="link link-hover" href={`mailto:${artist.email}`}>{artist.email}</a></p>
          <p><span class="text-base-content/60 text-sm block">Socials</span>{artist.handle} on {artist.socials.map((s, i) => <>{i > 0 && ' / '}<a class="link link-hover" href={s.url} target="_blank" rel="noopener">{s.label}</a></>)}</p>
          <p><span class="text-base-content/60 text-sm block">Listen on</span>{release.links.map((l, i) => <>{i > 0 && ' | '}<a class="link link-hover" href={l.url} target="_blank" rel="noopener">{l.label}</a></>)}</p>
        </div>
      </div>
      <p class="text-sm text-base-content/60">For high resolution photos and press assets, please <a class="link" href={`mailto:${artist.email}`}>contact me</a>.</p>
    </aside>
  </div>
</Base>
