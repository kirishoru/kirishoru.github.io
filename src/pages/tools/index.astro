---
import Base from '../../layouts/Base.astro'
---
<Base title="Tools" heading="Tools" subtitle="Built in the browser. Nothing you enter leaves your device.">
<div class="grid gap-6 sm:grid-cols-2">
        <a href="/prioritize/" class="card bg-base-100 shadow-sm hover:shadow-xl hover:-translate-y-0.5 transition">
          <div class="card-body">
            <div class="badge badge-soft badge-primary">Decide</div>
            <h2 class="card-title text-2xl">Prioritize</h2>
            <p class="text-base-content/70">Rank a list of options by comparing them two at a time. Catches contradictions and flags real toss-ups.</p>
            <div class="card-actions justify-end"><span class="btn btn-primary btn-sm">Open</span></div>
          </div>
        </a>
        <a href="/bodycomp/" class="card bg-base-100 shadow-sm hover:shadow-xl hover:-translate-y-0.5 transition">
          <div class="card-body">
            <div class="badge badge-soft badge-secondary">Measure</div>
            <h2 class="card-title text-2xl">Body composition</h2>
            <p class="text-base-content/70">Body fat from skinfold calipers, then resting and daily calories from lean mass.</p>
            <div class="card-actions justify-end"><span class="btn btn-secondary btn-sm">Open</span></div>
          </div>
        </a>
      </div>
</Base>
